{
  "name": "pons-robinhood-buy-sell-api",
  "version": "0.2.0-beta",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "PONS Robinhood Chain Buy and Sell API: unsigned transactions, stage checks, local signing and atomic 0.25% fees. Settlement deployment is required before trading.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "compile": "node scripts/compile.mjs",
    "build:check": "wrangler deploy --dry-run",
    "site:preview": "node scripts/preview-site.mjs",
    "site:check": "node --test test/site.test.js"
  },
  "dependencies": {
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "prettier": "3.6.2",
    "prettier-plugin-solidity": "1.4.3",
    "solc": "0.8.37",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
